# 个人知识库 —— 配置示例。复制为 .env 后按需修改；真实环境变量优先于 .env。
# 默认值开箱即用：LLM 与 Embedding 均为 mock，无需任何 key。

# ---- LLM：mock | deepseek | openai | ollama ----
LLM_PROVIDER=mock
LLM_API_KEY=
# 留空则使用各 Provider 默认地址与模型
LLM_BASE_URL=
LLM_MODEL=

# ---- Embedding：mock | local（fastembed，首次使用需联网下载约 100MB 模型）----
EMBEDDING_MODE=mock
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 语义路相似度下限；留空则 mock=0.3、真实模型=0.4（由 scripts/calibrate_sem_threshold.py 标定）
SEM_MIN_SIM=

# ---- 服务 ----
DB_PATH=./data/kb.db
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 设置后所有接口（除 /health）需携带请求头 X-KB-Token
KB_API_TOKEN=
# 入库后是否自动后台处理（摘要/标签/向量化/分类）；0 关闭
AUTO_PROCESS=1

# 用户修正反馈：相似文档被用户改过分类时，其目标分类置顶为候选的相似度下限
CORR_MIN_SIM=0.5
